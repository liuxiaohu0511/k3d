{
  "mountpoint": "/data",
  "fs_name": "jfs-router",
  "allow_other": true,
  "debug": false,

  "entry_timeout_ms": 1000,
  "attr_timeout_ms": 1000,

  "cache": {
    "capacity": 4096,
    "ttl_seconds": 30,
    "negative_ttl_seconds": 5,
    "list_ttl_seconds": 30
  },

  "metastore": {
    "type": "file",
    "file": {
      "path": "/etc/jfs-router/mounts.json"
    }
  }
}
